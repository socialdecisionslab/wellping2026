{
  "expo": {
    "name": "Well Ping",
    "slug": "wellping-app",
    "owner": "ssnl",
    "platforms": ["ios", "android"],
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wellping",
      "buildNumber": "33",
      "associatedDomains": ["applinks:wellping.github.io"]
    },
    "android": {
      "package": "edu.stanford.ssnl.wellping",
      "versionCode": 33,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#F4F4F4"
      },
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wellping.github.io",
              "pathPrefix": "/app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "allowBackup": false
    },
    "plugins": ["expo-secure-store", "expo-notifications"]
  }
}
