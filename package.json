{
  "name": "wellping",
  "version": "1.1.3",
  "main": "index.js",
  "scripts": {
    "test": "tsc --noEmit && jest",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:ci": "yarn test --runInBand --watchman=false && yarn test:security",
    "start:local": "node scripts/start-local.cjs",
    "check:environment": "node scripts/check-environment.cjs",
    "smoke:local": "node scripts/smoke-local.cjs && node scripts/smoke-server.cjs",
    "test:security": "node tests/security/secure-resume.cjs && node scripts/security/check-network-boundaries.cjs && node scripts/test-security-diagnostics.cjs && node tests/security/home-recovery.cjs && node tests/security/data-journal.cjs",
    "prebuild:local": "WELLPING_LOCAL_ONLY=1 expo prebuild",
    "android:local": "WELLPING_LOCAL_ONLY=1 expo run:android",
    "ios:local": "WELLPING_LOCAL_ONLY=1 expo run:ios",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"local/**/*.{ts,tsx}\" \"config/**/*.{ts,tsx}\" App.tsx \"researcher-console/**/*.{js,cjs}\" scripts/build-research-console.cjs scripts/release-manifest.cjs",
    "researcher:local": "node scripts/build-research-console.cjs && node researcher-console/server.cjs",
    "test:researcher": "node scripts/build-research-console.cjs && node --test researcher-console/tests/*.test.cjs",
    "release:manifest": "node scripts/release-manifest.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@wellping/study-schemas": "file:vendor/wellping-study-schemas-1.0.0.tgz",
    "date-fns": "^2.14.0",
    "expo": "57.0.30",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "firebase": "13.0.0",
    "js-yaml": "^3.14.0",
    "lodash": "^4.17.19",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-uuid": "^2.0.1",
    "react-native-webview": "13.16.1",
    "seedrandom": "^3.0.5",
    "url": "^0.11.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/js": "10.0.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.158",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "10.13.0",
    "jest": "^29.7.0",
    "jest-date-mock": "^1.0.8",
    "jest-expo": "~57.0.6",
    "jsdom": "20.0.3",
    "prettier": "^2.5.1",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "wait-for-expect": "^3.0.2"
  },
  "jest": {
    "verbose": true,
    "restoreMocks": true,
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|firebase|@firebase/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testMatch": [
      "**/__tests__/**/*.(spec|test).[jt]s?(x)"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/setupGlobalVariables.js",
      "<rootDir>/src/__tests__/setupAsyncStorage.js",
      "<rootDir>/src/__tests__/setupSecureStore.ts",
      "<rootDir>/src/__tests__/setupCrypto.js",
      "jest-date-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.ts"
    ],
    "globalSetup": "<rootDir>/src/__tests__/globalSetup.ts",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "App.tsx",
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/inc/**",
      "config/**/*.{js,jsx,ts,tsx}",
      "utility/**/*.{js,jsx,ts,tsx}",
      "!**/__tests__/**",
      "!**/node_modules/**"
    ],
    "snapshotFormat": {
      "escapeString": true,
      "printBasicPrototype": true
    },
    "transform": {
      "^.+\\.mjs$": "babel-jest"
    }
  },
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "22.23.3"
  },
  "resolutions": {
    "zod@^3.11.6": "3.25.76",
    "@grpc/grpc-js": "1.14.6"
  }
}
