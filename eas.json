{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "WELLPING_LOCAL_ONLY": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "WELLPING_LOCAL_ONLY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "WELLPING_RELEASE_ENV": "staging",
        "WELLPING_BACKEND_PROTOCOL": "wellping-v1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "WELLPING_RELEASE_ENV": "production",
        "WELLPING_BACKEND_PROTOCOL": "wellping-v1"
      }
    }
  }
}
